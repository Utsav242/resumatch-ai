# ==========================================
# Resumiq - Global Environment Config
# ==========================================

# Environment Mode: development | staging | production
NODE_ENV=development
ENVIRONMENT=development

# ------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------
POSTGRES_USER=resumatch_admin
POSTGRES_PASSWORD=ResumeMatch_Pass2026!
POSTGRES_DB=resumatch_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://resumatch_admin:ResumeMatch_Pass2026!@localhost:5433/resumatch_db

# ------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO

# ------------------------------------------
# Frontend Service Configuration (Next.js)
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------
# AI Provider Configuration (Future Phases)
# ------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
HUGGINGFACE_TOKEN=your_huggingface_token_here
